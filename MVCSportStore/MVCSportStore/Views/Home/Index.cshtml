@model MVCSportStore.ViewModels.ProductModel

@{
    ViewData["Title"] = "Home Page";
}
<a asp-controller="Product" asp-action="Create">Create Product</a>

@foreach(var product in Model.Products)
{
    <partial name="ProductSummary" model="product"/>
    
}
<br />
<div class="row">
    @for (int i = 1; i <= Model.PagingInfo.TotalPages; i++)
    {
        <div class="col text-center">
            <button>
                <a class="text-decoration-none" asp-controller="Home" asp-action="Index" asp-route-id="@i">@i</a>
            </button>
        </div>
    }
</div>
