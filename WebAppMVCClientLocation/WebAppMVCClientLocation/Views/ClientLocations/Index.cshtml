@{
}
@model IEnumerable<WebAppMVCClientLocation.ViewModels.ClientLocationViewModel>
<h1>Client Locations</h1>
<table>
    <thead>
        <tr>
            <th>ClientName</th>
            <th>City</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ClientName</td>
                <td>@item.City</td>
            </tr>
        }
    </tbody>
</table>