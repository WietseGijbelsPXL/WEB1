@{

}
@model IEnumerable<Client>
<h2>Clients</h2>
<a asp-controller="Clients" asp-action="Create">Add Client</a>
<table>
    <thead>
        <tr>
            <th>ClientId</th>
            <th>LocationId</th>
            <th>ClientName</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Client client in Model)
        {
            <tr>
                <td>@client.ClientId</td>
                <td>@client.LocationId</td>
                <td>@client.ClientName</td>
            </tr>
        }
    </tbody>
</table>