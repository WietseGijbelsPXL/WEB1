@{
}
@model TeamImageViewModel
<h2>Upload Player Image</h2>
<form asp-action="UploadImage" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label">
            Select image
        </label>
        <input asp-for="ImageFile"
               type="file"
               class="form-control"
               accept="image/*" />
        <span asp-validation-for="ImageFile"
              class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">
        Upload Image
    </button>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}