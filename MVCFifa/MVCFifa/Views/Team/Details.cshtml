@model MVCFifa.Models.Team

@{
    ViewData["Title"] = "Details";
    var fileExists = Convert.ToBoolean(ViewBag.FileExists);
    var imgLink = "";
    if (fileExists) imgLink = $"/images/{Model.ImageLinkClub}";
}

<h1>Details</h1>

<div>
    <h4>Team</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TeamName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TeamName)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ImageLinkClub)
        </dt>
        <dd class = "col-sm-10">
            @if (fileExists)
            {
                <img src="@imgLink" alt="Player Image" width="200" />
            }
            else
            {
                <br />
                <a asp-controller="Team" asp-action="UploadImage" asp-route-id="@Model?.TeamId">Upload Image</a>
                <br />
                <br />
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.TeamId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
